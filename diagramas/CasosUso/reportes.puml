@startuml ReportesEstadisticas
'left to right direction
actor "Administrador" as Admin

rectangle "Reportes y Estadísticas" {
    usecase (Gestionar Reportes) as UC1
    usecase (Generar Reporte de Ventas) as UC2
    usecase (Generar Reporte de Servicios) as UC3
    usecase (Ver Estadísticas) as UC4
    usecase (Exportar Reportes) as UC5
    usecase (Personalizar Reporte) as UC6
}

Admin --> UC1
UC1 ..> UC2 : include
UC1 ..> UC3 : include
UC1 ..> UC4 : include
UC2 ..> UC5 : extend
UC3 ..> UC5 : extend
UC2 ..> UC6 : extend
UC3 ..> UC6 : extend
@enduml