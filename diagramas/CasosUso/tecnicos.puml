@startuml GestionTecnicos
left to right direction
actor "Administrador" as Admin

rectangle "Gestión de Técnicos" {
    usecase (Gestionar Técnicos) as UC1
    usecase (Registrar Técnico) as UC2
    usecase (Actualizar Técnico) as UC3
    usecase (Buscar Técnico) as UC4
    usecase (Eliminar Técnico) as UC5
    usecase (Ver Detalles del Técnico) as UC6
    usecase (Asignar Especialidad) as UC7
}

Admin --> UC1
UC1 ..> UC2 : include
UC1 ..> UC3 : include
UC1 ..> UC4 : include
UC1 ..> UC5 : include
UC2 ..> UC7 : include
UC3 ..> UC7 : include
UC4 ..> UC6 : extend
@enduml